rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Every tenant-scoped read/write is gated on this one lookup: does the
    // signed-in user have a `memberships/{uid}` document, and does its
    // `orgId` match the organization being accessed. This is the single
    // enforcement point for tenant isolation — no rule below this line
    // trusts a client-supplied orgId on its own.
    function orgIdOf(uid) {
      return get(/databases/$(database)/documents/memberships/$(uid)).data.orgId;
    }

    function isMember(orgId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/memberships/$(request.auth.uid))
        && orgIdOf(request.auth.uid) == orgId;
    }

    // One membership document per Firebase user, created once by
    // `bootstrapOrgForNewOwner` right after store setup. A brand-new
    // owner's orgId must equal their own uid (see
    // OrgMembershipRepository.createOrgForNewOwner) — that's enforced here,
    // not just assumed client-side, so nobody can point their membership at
    // an organization they don't own. Inviting a second member into an
    // *existing* org (their uid necessarily differs from that orgId) is a
    // privileged operation and goes through a Cloud Function using the
    // Admin SDK later — not a client-writable path, hence update/delete
    // are blocked entirely here for now.
    match /memberships/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.orgId == uid
        && request.resource.data.role == 'owner';
      allow update, delete: if false;
    }

    // All tenant data — the store profile itself plus every synced list
    // (products, customers, sales, shifts, debts, ...) nested under
    // `organizations/{orgId}/data/{collectionName}` — lives behind the
    // same membership check, recursively.
    match /organizations/{orgId} {
      allow read, write: if isMember(orgId);

      match /{document=**} {
        allow read, write: if isMember(orgId);
      }
    }

    // Platform-wide, non-tenant collections: readable by anyone (or any
    // signed-in user), never client-writable — Super Admin tooling and
    // Cloud Functions write these with the Admin SDK, which bypasses rules.
    match /platform_config/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /countries/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /feature_flags/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /broadcasts/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
